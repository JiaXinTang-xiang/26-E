<launch>
  <!-- 把 YOUR_PACKAGE 改成存放这些脚本的ROS包名。 -->
  <node pkg="YOUR_PACKAGE"
        type="onsite_puzzle_solver_final.py"
        name="puzzle_piece_detector"
        output="screen">
    <rosparam command="load"
              file="$(find YOUR_PACKAGE)/config/competition_params.yaml" />
  </node>

  <node pkg="YOUR_PACKAGE"
        type="onsite_puzzle_executor_final.py"
        name="onsite_puzzle_executor"
        output="screen">
    <rosparam command="load"
              file="$(find YOUR_PACKAGE)/config/competition_executor_params.yaml" />
  </node>
</launch>
